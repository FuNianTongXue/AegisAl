{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "神盾",
  "version": "1.3.4",
  "identifier": "ai.secflow.security-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:18781 http://127.0.0.1:18783; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:18781 http://127.0.0.1:18783; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    },
    "windows": [
      {
        "label": "main",
        "title": "神盾",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "category": "DeveloperTool",
    "shortDescription": "AegisAl Security Analyst",
    "longDescription": "AegisAl cross-platform AI security analysis client"
  }
}
